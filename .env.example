# Firebase Configuration (Auth + Firestore — Plan Spark Gratuito)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary (Imágenes 100% Gratuito — 25 GB de almacenamiento)
# NOTA: Solo se usa Unsigned Upload. NO coloques API Secret aquí.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Mercado Pago
VITE_MP_PUBLIC_KEY=your_mercadopago_public_key

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# WhatsApp (sin el +, solo números)
VITE_WHATSAPP_NUMBER=5491100000000

# Site
VITE_SITE_URL=http://localhost:5173
