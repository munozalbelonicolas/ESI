# Firebase Configuration (Auth + Firestore — Plan Spark Gratuito)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary (Imágenes 100% Gratuito — 25 GB de almacenamiento)
# NOTA: Solo se usa Unsigned Upload. NO coloques API Secret aquí.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Mercado Pago (credenciales del cliente)
VITE_MP_PUBLIC_KEY=your_mercadopago_public_key

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# WhatsApp (sin el +, solo números)
VITE_WHATSAPP_NUMBER=5491100000000

# Site
VITE_SITE_URL=http://localhost:5173

# API base URL para serverless functions (vacío si se sirve desde Vercel)
VITE_API_BASE_URL=

# ========================================
# VARIABLES DE SERVIDOR (Vercel Environment Variables)
# Configurar en Vercel Dashboard > Settings > Environment Variables
# NO poner estas en el .env del frontend — son secretas
# ========================================

# Mercado Pago (server-side)
MP_ACCESS_TOKEN=your_mercadopago_access_token

# Resend (email transaccional — plan gratuito 3K/mes)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@esi-secundaria.com.ar
ADMIN_EMAIL=admin@esi-secundaria.com.ar

# Firebase Admin SDK (para escribir Firestore desde las API routes)
# Se obtienen en Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=your_private_key_with_escaped_newlines

# Stock bajo
LOW_STOCK_THRESHOLD=5
