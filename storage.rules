rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSmallImage() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Imágenes de productos — lectura pública, escritura solo admin
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSmallImage();
    }

    // Comprobantes de transferencia — hoy se guardan en Firestore (transferProofs).
    // Sin acceso desde el cliente; si se habilita Storage, validar titularidad de la orden.
    match /transfer-proofs/{allPaths=**} {
      allow read, write: if false;
    }

    // Imágenes de blog — lectura pública, escritura solo admin
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isSmallImage();
    }
  }
}
