rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Imágenes de productos — lectura pública, escritura solo usuarios autenticados
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comprobantes de transferencia — lectura admin, escritura usuario autenticado
    match /transfer-proofs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Imágenes de blog — lectura pública, escritura solo usuarios autenticados
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
