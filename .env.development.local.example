# Configuración segura para Firebase Emulator. Copiar a .env.development.local.
# No reemplazar por credenciales del proyecto de producción.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-esi-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-esi-local
VITE_FIREBASE_STORAGE_BUCKET=demo-esi-local.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_FIREBASE_EMULATOR=true
VITE_SITE_URL=http://localhost:3000
VITE_API_BASE_URL=
