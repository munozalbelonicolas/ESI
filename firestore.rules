rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Users ──
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Products ──
    match /products/{productId} {
      // Lectura pública de productos activos
      allow read: if true;
      // Solo admins pueden escribir
      allow create, update, delete: if isAdmin();
    }

    // ── Blog Posts ──
    match /blogPosts/{postId} {
      // Lectura pública de posts publicados
      allow read: if true;
      // Solo admins pueden escribir
      allow create, update, delete: if isAdmin();
    }

    // ── Orders ──
    match /orders/{orderId} {
      // El usuario dueño o un admin pueden leer
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      // Un usuario autenticado puede crear su propia orden
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      // Solo admin puede actualizar (cambiar estados)
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Coupons ──
    match /coupons/{couponId} {
      // Lectura pública (necesaria para validación en el frontend)
      allow read: if true;
      // Solo admins pueden escribir
      allow create, update, delete: if isAdmin();
    }

    // ── Settings (Datos bancarios, Envíos, Configuración de Mercado Pago) ──
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
